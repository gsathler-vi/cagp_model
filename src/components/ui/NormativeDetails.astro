---
// NormativeDetails.astro - Encapsulamento de Textos Regimentais e Normas
interface Props {
  id?: string;
  title: string;
  badge?: string;
  icon?: string;
  open?: boolean;
}

const { id, title, badge, icon, open = false } = Astro.props;
---

<details id={id} class="cagp-normative-details bg-white border border-black/15 rounded-[6px] my-2 overflow-hidden transition-all shadow-xs hover:shadow-sm" open={open}>
  <summary class="px-3.5 py-2.5 min-h-[44px] cursor-pointer font-['Oswald'] font-bold text-sm uppercase text-[#0A0A0A] bg-[#F7F5F0] hover:bg-[#EAE5DC] flex items-center justify-between select-none transition-colors">
    <span class="flex items-center gap-2">
      <i class="bi bi-chevron-right text-xs transition-transform duration-200 details-icon text-gray-500" aria-hidden="true"></i>
      {icon && <i class={`bi ${icon} text-[#8B1E2D] text-base shrink-0`} aria-hidden="true"></i>}
      <span class="leading-tight">{title}</span>
    </span>
    {badge && (
      <span class="cagp-badge cagp-badge-red shrink-0 ml-2">
        {badge}
      </span>
    )}
  </summary>
  <div class="px-4 py-3 text-sm text-gray-800 leading-relaxed border-t border-[#DFDBD2] bg-white">
    <slot />
  </div>
</details>

<style>
  .details-icon {
    transition: transform 0.22s var(--ease-out-natural, cubic-bezier(0.16, 1, 0.3, 1));
  }
  details[open] summary .details-icon {
    transform: rotate(90deg);
  }
  details > div {
    overflow: hidden;
  }
</style>

<script>
  function setupDetailsAccordions() {
    document.querySelectorAll<HTMLDetailsElement>('details.cagp-normative-details').forEach((details) => {
      const summary = details.querySelector('summary');
      const content = details.querySelector(':scope > div') as HTMLElement | null;
      if (!summary || !content) return;

      if ((details as any).__cagp_animated) return;
      (details as any).__cagp_animated = true;

      summary.addEventListener('click', (e) => {
        e.preventDefault();

        const isReducedMotion =
          window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
          document.documentElement.getAttribute('data-a11y-motion') === 'reduced';

        if (isReducedMotion) {
          details.open = !details.open;
          return;
        }

        // Cancelar animação concorrente anterior se houver
        if ((content as any).__current_anim) {
          (content as any).__current_anim.cancel();
        }

        if (details.open) {
          const startHeight = content.offsetHeight;
          const anim = content.animate(
            [
              { height: `${startHeight}px`, opacity: '1', transform: 'translateY(0)' },
              { height: '0px', opacity: '0', transform: 'translateY(-6px)' }
            ],
            { duration: 220, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' }
          );
          (content as any).__current_anim = anim;
          anim.onfinish = () => {
            details.open = false;
            (content as any).__current_anim = null;
          };
        } else {
          details.open = true;
          const endHeight = content.offsetHeight;
          const anim = content.animate(
            [
              { height: '0px', opacity: '0', transform: 'translateY(-8px)' },
              { height: `${endHeight}px`, opacity: '1', transform: 'translateY(0)' }
            ],
            { duration: 260, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' }
          );
          (content as any).__current_anim = anim;
          anim.onfinish = () => {
            (content as any).__current_anim = null;
          };
        }
      });
    });
  }

  setupDetailsAccordions();
  document.addEventListener('astro:page-load', setupDetailsAccordions);
</script>
