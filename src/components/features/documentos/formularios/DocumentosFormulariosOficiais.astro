  },
  {
    title: 'Termo de Compromisso de Estágio sem Vínculo Direto',
    pdf: 'estagio-modelo-termo-de-compromisso-sem-vinculo.pdf',
    docx: 'estagio-modelo-termo-de-compromisso-sem-vinculo.docx',
    desc: 'Minuta para concessão de estágio operacionalizada através de agentes integradores (CIEE, IEL, etc.).',
    badge: 'TCE Agente',
    category: 'estagio',
  },
  {
    title: 'Plano de Atividades de Estágio Supervisionado',
    pdf: 'estagio-modelo-plano-de-atividades.pdf',
    docx: 'estagio-modelo-plano-de-atividades.docx',
    desc: 'Cronograma detalhado de atribuições assinado pelo supervisor institucional e orientador docente.',
    badge: 'Plano de Estágio',
    category: 'estagio',
  },
  {
    title: 'Relatório Semestral de Atividades de Estágio',
    pdf: 'estagio-modelo-relatorio-semestral.pdf',
    docx: 'estagio-modelo-relatorio-semestral.docx',
    desc: 'Comprovação periódica do cumprimento do plano de estágio a cada 6 meses letivos.',
    badge: 'Relatório Parcial',
    category: 'estagio',
  },
  {
    title: 'Relatório Final de Conclusão do Estágio',
    pdf: 'estagio-modelo-relatorio-final.pdf',
    docx: 'estagio-modelo-relatorio-final.docx',
    desc: 'Avaliação de desempenho final e síntese de aprendizagem para integralização de DCP 135 ou DCP 136.',
    badge: 'Integralização 150h/300h',
    category: 'estagio',
  },
  {
    title: 'Dispensa Art. 41 (Requerimento por Vínculo Profissional)',
    pdf: 'estagio-requerimento-integralizacao-experiencia-profissional.pdf',
    docx: 'estagio-requerimento-integralizacao-experiencia-profissional.docx',
    desc: 'Solicitação formal de dispensa de estágio para servidores públicos efetivos, contratados ou terceiro setor.',
    badge: 'Art. 41 Regulamento',
    category: 'estagio',
  },
  {
    title: 'Dispensa Art. 41 (Relatório de Atividades Profissionais)',
    pdf: 'estagio-relatorio-atividades-experiencia-profissional.pdf',
    docx: 'estagio-relatorio-atividades-experiencia-profissional.docx',
    desc: 'Relatório avaliativo circunstanciado de atribuições do cargo para validação das 300h de estágio.',
    badge: 'Art. 41 Regulamento',
    category: 'estagio',
  },
  {
    title: 'Manual de Orientações de Estágio da FAFICH',
    pdf: 'estagio-manual-orientacoes-fafich.pdf',
    desc: 'Manual completo da Diretoria da FAFICH com diretrizes de seguro, tramitação SEI e convênios.',
    badge: 'Manual FAFICH',
    category: 'estagio',
  },

  // 2. Atividades Complementares (AAC)
  {
    title: 'Requerimento de AAC / Horas Complementares (N-20229)',
    pdf: 'requerimento-atividade-integralizadora-credito-v20229.pdf',
    desc: 'Protocolo das 300h nas 9 categorias do Art. 15 da Versão Curricular vigente.',
    badge: 'Versão N-20229',
    category: 'aac',
  },
  {
    title: 'Requerimento de AAC / Horas Complementares (N-20152)',
