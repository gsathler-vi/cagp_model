  {
    title: 'Compilado de Depoimentos de Egressos',
    pdf: 'depoimentos-de-egressos.pdf',
    desc: 'Trajetórias profissionais de egressos do curso no setor público, consultoria e academia.',
    badge: 'Egressos',
    category: 'guia',
  },
];
---

<div class="cagp-documentos-formularios space-y-6 select-none text-[#0A0A0A]">
  <div class="p-4 bg-white border border-[#DFDBD2] rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-xs">
    <div>
      <span class="text-[11px] font-['Oswald'] uppercase font-bold tracking-wider text-[#15803D]">
        Modelos Padronizados & Minutas Editáveis
      </span>
      <h3 class="font-['Oswald'] text-base font-bold uppercase text-[#0A0A0A] m-0">
        Formulários Oficiais, Modelos de Estágio e Roteiros
      </h3>
      <p class="text-xs text-gray-600 mt-0.5 m-0">
        Requerimentos para protocolo no Colegiado e os 7 modelos de estágio em formato duplo (PDF e DOCX editável).
      </p>
    </div>
    <span class="px-2.5 py-1 rounded bg-[#15803D] text-white font-mono text-xs font-bold shrink-0">
      {formularios.length} Modelos Catalogados
    </span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
    {formularios.map((doc) => (
      <div class="cagp-card p-4 bg-white border border-[#DFDBD2] hover:border-[#0A0A0A] rounded-xl flex flex-col justify-between gap-3 transition-all shadow-xs">
        <div class="flex items-start gap-3 min-w-0">
          <div class="w-9 h-9 rounded-lg bg-[#15803D]/10 text-[#15803D] border border-[#15803D]/20 flex items-center justify-center shrink-0 mt-0.5">
            <i class="bi bi-file-earmark-check-fill text-base" aria-hidden="true" />
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-1.5 mb-1 flex-wrap">
              <span class="cagp-badge cagp-badge-dark text-[10px] font-mono">{doc.badge}</span>
              <h4 class="font-['Oswald'] font-bold text-xs uppercase text-[#0A0A0A] leading-snug m-0">{doc.title}</h4>
            </div>
            <p class="text-xs text-gray-600 leading-relaxed m-0">{doc.desc}</p>
          </div>
        </div>

        <div class="pt-2 border-t border-[#DFDBD2] flex items-center justify-end gap-2 flex-wrap">
          <a
            href={asset(`/documentos/${doc.pdf}`)}
            download
            class="min-h-[36px] px-3 py-1.5 bg-[#8B1E2D] hover:bg-[#0A0A0A] text-white rounded-lg text-xs font-mono font-bold inline-flex items-center gap-1.5 transition-colors no-underline shadow-xs"
            title={`Baixar PDF: ${doc.title}`}
          >
            <i class="bi bi-file-earmark-pdf" aria-hidden="true" />
            <span>Baixar PDF</span>
          </a>
          {doc.docx && (
            <a
              href={asset(`/documentos/${doc.docx}`)}
              download
              class="min-h-[36px] px-3 py-1.5 bg-[#005A9C] hover:bg-[#0A0A0A] text-white rounded-lg text-xs font-mono font-bold inline-flex items-center gap-1.5 transition-colors no-underline shadow-xs"
              title={`Baixar DOCX editável: ${doc.title}`}
            >
              <i class="bi bi-file-earmark-word" aria-hidden="true" />
              <span>DOCX Editável</span>
            </a>
          )}
        </div>
      </div>
    ))}
  </div>
</div>
