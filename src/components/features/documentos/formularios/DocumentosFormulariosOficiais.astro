---
// src/components/features/documentos/formularios/DocumentosFormulariosOficiais.astro — Formulários Oficiais e Modelos de Requerimento
import { asset } from '../../../../lib/paths';

interface FormularioItem {
  title: string;
  pdf: string;
  docx?: string;
  desc: string;
  badge: string;
  category: 'estagio' | 'aac' | 'tcc' | 'curriculo' | 'guia';
