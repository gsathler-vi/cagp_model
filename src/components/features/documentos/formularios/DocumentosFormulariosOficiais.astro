const formularios: FormularioItem[] = [
  // 1. Estágio Supervisionado (Formatos Duplos PDF + DOCX)
  {
    title: 'Termo de Compromisso de Estágio com Convênio',
    pdf: 'estagio-modelo-termo-de-compromisso-com-convenio.pdf',
    docx: 'estagio-modelo-termo-de-compromisso-com-convenio.docx',
    desc: 'Minuta obrigatória tripartite para órgãos e instituições formalmente conveniados com a UFMG.',
