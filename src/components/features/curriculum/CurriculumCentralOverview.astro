---
// src/components/features/curriculum/CurriculumCentralOverview.astro — Visão Geral da Central Curricular & Grafo 10P
import { CurriculumGraphWidget } from './graph/CurriculumGraphWidget';
import { CurriculumDossierWidget } from './dossie/CurriculumDossierWidget';
import { AcgCalculatorWidget } from '../acg/calculator/AcgCalculatorWidget';
import { route, asset } from '../../../lib/paths';

const percursos = [
  {
    codigo: '01-01',
    nome: 'Bacharelado com Núcleo Geral',
    slug: 'percurso-bacharelado-nucleo-geral',
    badge: 'Vínculo Automático no 1ºP',
    badgeVariant: 'green' as const,
    desc: 'Percurso canônico da FAFICH/UFMG. Proporciona formação sólida e generalista em gestão pública, finanças e ciência política, com máxima autonomia na escolha de matérias optativas.',
    obrig: '1.560h (25 disciplinas) + 300h Estágio (A + B)',
    opt: '1.020h optativas (DCP/Extensão/AAC) + 120h Livre',
    pdf: '/documentos/percurso-bacharelado-nucleo-geral.pdf',
    size: '166 KB',
  },
  {
    codigo: '01-02',
    nome: 'Núcleo Complementar (Transversal / Aberta)',
    slug: 'percurso-bacharelado-nucleo-complementar',
    badge: 'Opção no 4ºP para o 5ºP+',
    badgeVariant: 'red' as const,
    desc: 'Permite cursar 300 horas em Formação Transversal (Direitos Humanos, Relações Étnico-Raciais, Meio Ambiente) ou Formação Complementar Aberta (FCA) em outro departamento da UFMG.',
    obrig: '300h dedicadas à área interdisciplinar certificada',
    opt: 'Optativas DCP reduzidas de 1.020h para 720h (-300h)',
    pdf: '/documentos/percurso-bacharelado-nucleo-complementar.pdf',
    size: '167 KB',
  },
  {
    codigo: '01-03',
    nome: 'Núcleo Avançado (Articulação com Pós-Graduação)',
    slug: 'percurso-bacharelado-nucleo-avancado',
    badge: 'Opção no 4ºP para o 7ºP+',
    badgeVariant: 'blue' as const,
    desc: 'Destinado a discentes com vocação para pesquisa e carreira acadêmica. Permite cursar entre 45h e 120h em disciplinas de Mestrado/Doutorado no PPGCP/FAFICH ainda na graduação.',
    obrig: '45h a 120h com aproveitamento formal no mestrado',
    opt: 'Optativas DCP de 900h a 975h + 120h Livre',
    pdf: '/documentos/percurso-bacharelado-nucleo-avancado.pdf',
    size: '167 KB',
  },
];
---

<div class="cagp-curriculum-central-overview space-y-6 select-none text-[#0A0A0A]">
  <!-- Apresentação da Central Curricular -->
  <div class="p-4 sm:p-5 bg-[#F7F5F0] border border-[#DFDBD2] rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-xs">
    <div class="flex items-start gap-3.5">
      <span class="w-11 h-11 rounded-lg bg-[#15803D] text-white flex items-center justify-center text-xl shrink-0 mt-0.5 shadow-[2px_2px_0px_#0A0A0A]">
        <i class="bi bi-diagram-3-fill" aria-hidden="true" />
      </span>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-[11px] font-['Oswald'] uppercase font-bold tracking-wider text-[#15803D]">
            Central Curricular & Matriz 10P
          </span>
          <span class="text-gray-300">•</span>
          <span class="text-xs text-gray-500 font-mono">3.000 horas de integralização</span>
        </div>
        <h2 class="font-['Oswald'] text-lg sm:text-xl font-bold uppercase text-[#0A0A0A] leading-tight m-0">
          27 Obrigatórias, 68 Optativas, 120h Livres, Estágio e TCC
        </h2>
        <p class="text-xs text-gray-600 mt-1 max-w-3xl leading-relaxed m-0">
          Navegue pela matriz de 10 semestres, adicione disciplinas optativas diretamente nas colunas do Grafo e monitore o seu progresso rumo à colação de grau.
        </p>
      </div>
    </div>

    <div class="flex items-center gap-2 shrink-0">
      <a
        href={asset('/documentos/ementario-gestao-publica-ufmg.pdf')}
        download
        class="min-h-[44px] px-3.5 py-2 bg-white hover:bg-[#8B1E2D] hover:text-white border border-[#DFDBD2] hover:border-[#0A0A0A] rounded-lg text-xs font-['Oswald'] uppercase font-bold text-[#0A0A0A] inline-flex items-center gap-2 transition-all no-underline shadow-xs"
      >
        <i class="bi bi-file-earmark-pdf text-[#8B1E2D] hover:text-white" aria-hidden="true" />
        <span>Ementário Geral (PDF)</span>
      </a>
    </div>
  </div>

  <!-- Bento Grid de Widgets do Currículo -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <CurriculumGraphWidget client:load />
    <CurriculumDossierWidget client:load />
    <AcgCalculatorWidget client:load />
  </div>

  <!-- Os 3 Percursos Curriculares Oficiais -->
  <div class="p-4 sm:p-5 bg-white border border-[#DFDBD2] rounded-xl space-y-4 shadow-xs">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-[#DFDBD2] pb-3">
      <div>
        <span class="text-[11px] font-['Oswald'] uppercase font-bold tracking-wider text-[#8B1E2D]">
          Regulamento do Curso · Art. 3º & PPC 2020
        </span>
        <h3 class="font-['Oswald'] text-base font-bold uppercase text-[#0A0A0A] m-0">
          Os 3 Percursos Formativos Oficiais
        </h3>
        <p class="text-xs text-gray-600 mt-0.5 m-0">
          Todo discente ingressa no Percurso 01-01 e pode optar no 4º período por direcionar sua carga optativa em Formação Complementar ou Pós-Graduação.
        </p>
      </div>
      <span class="px-2.5 py-1 rounded bg-[#0A0A0A] text-white font-mono text-xs font-bold self-start sm:self-auto shrink-0">
        Versão N-20229
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5">
      {percursos.map((p) => (
        <div class="cagp-card p-4 bg-[#F7F5F0] border border-[#DFDBD2] rounded-xl flex flex-col justify-between space-y-3 shadow-xs">
          <div class="space-y-2">
            <div class="flex items-center justify-between gap-2 flex-wrap">
              <span class="font-mono text-xs font-bold px-2 py-0.5 rounded bg-[#0A0A0A] text-white">
                {p.codigo}
              </span>
              <span class={`text-[10px] font-mono font-bold px-2 py-0.5 rounded ${
                p.badgeVariant === 'green' ? 'bg-[#15803D]/10 text-[#15803D] border border-[#15803D]/30' :
                p.badgeVariant === 'red' ? 'bg-[#8B1E2D]/10 text-[#8B1E2D] border border-[#8B1E2D]/30' :
                'bg-[#005A9C]/10 text-[#005A9C] border border-[#005A9C]/30'
              }`}>
                {p.badge}
              </span>
            </div>

            <h4 class="font-['Oswald'] text-sm font-bold uppercase text-[#0A0A0A] m-0 leading-snug">
              {p.nome}
            </h4>

            <p class="text-xs text-gray-700 leading-relaxed m-0">
              {p.desc}
            </p>

            <div class="pt-2 border-t border-[#DFDBD2] space-y-1 text-xs">
              <div>
                <span class="font-bold text-gray-800">Carga Obrigatória:</span>
                <span class="text-gray-600 block">{p.obrig}</span>
              </div>
              <div>
                <span class="font-bold text-gray-800">Flexibilidade:</span>
                <span class="text-gray-600 block">{p.opt}</span>
              </div>
            </div>
          </div>

          <div class="pt-2 border-t border-[#DFDBD2] flex flex-wrap gap-2">
            <a
              href={route(`/documentos/${p.slug}`)}
              class="flex-1 min-h-[36px] px-2.5 py-1.5 bg-white hover:bg-[#0A0A0A] hover:text-white border border-[#DFDBD2] rounded-lg text-xs font-['Oswald'] uppercase font-bold text-[#0A0A0A] inline-flex items-center justify-center gap-1.5 transition-colors no-underline text-center"
            >
              <i class="bi bi-eye" aria-hidden="true" />
              <span>Matriz Web</span>
            </a>
            <a
              href={asset(p.pdf)}
              download
              class="flex-1 min-h-[36px] px-2.5 py-1.5 bg-[#8B1E2D] hover:bg-[#0A0A0A] text-white rounded-lg text-xs font-mono font-bold inline-flex items-center justify-center gap-1.5 transition-colors no-underline text-center shadow-xs"
            >
              <i class="bi bi-file-earmark-pdf" aria-hidden="true" />
              <span>PDF ({p.size})</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Requerimentos de Mudança de Percurso no DRCA -->
    <div class="p-3.5 bg-[#FAF8F5] border border-[#DFDBD2] rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <span class="w-9 h-9 rounded-lg bg-[#0A0A0A] text-white flex items-center justify-center text-base shrink-0">
          <i class="bi bi-arrow-left-right" aria-hidden="true" />
        </span>
        <div>
          <h4 class="font-['Oswald'] text-xs uppercase font-bold text-[#0A0A0A] m-0">
            Formulários Oficiais do DRCA para Mudança de Percurso
          </h4>
          <p class="text-xs text-gray-600 m-0">
            Protocolo semestral junto ao DRCA e ao Colegiado de Gestão Pública para alteração formal de percurso curricular.
          </p>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <a
          href={asset('/documentos/requerimento-mudanca-percurso-curricular-drca.pdf')}
          download
          class="min-h-[36px] px-3 py-1.5 bg-white hover:bg-[#0A0A0A] hover:text-white border border-[#DFDBD2] rounded-lg text-xs font-mono font-bold text-[#0A0A0A] inline-flex items-center gap-1.5 transition-colors no-underline shadow-xs"
        >
          <i class="bi bi-file-earmark-pdf text-[#8B1E2D]" aria-hidden="true" />
          <span>Mudança de Percurso DRCA (PDF)</span>
        </a>
        <a
          href={asset('/documentos/requerimento-mudanca-percurso-modalidade-habilitacao-enfase.pdf')}
          download
          class="min-h-[36px] px-3 py-1.5 bg-white hover:bg-[#0A0A0A] hover:text-white border border-[#DFDBD2] rounded-lg text-xs font-mono font-bold text-[#0A0A0A] inline-flex items-center gap-1.5 transition-colors no-underline shadow-xs"
        >
          <i class="bi bi-file-earmark-pdf text-[#8B1E2D]" aria-hidden="true" />
          <span>Modalidade / Habilitação (PDF)</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Formação Complementar Aberta (FCA) e Formação Transversal -->
  <div class="p-4 sm:p-5 bg-white border border-[#DFDBD2] rounded-xl space-y-4 shadow-xs">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-[#DFDBD2] pb-3">
      <div>
        <span class="text-[11px] font-['Oswald'] uppercase font-bold tracking-wider text-[#005A9C]">
          Interdisciplinaridade · Resoluções CEPE & Congregação
        </span>
        <h3 class="font-['Oswald'] text-base font-bold uppercase text-[#0A0A0A] m-0">
          Formação Complementar Aberta (FCA) & Formações Transversais (300h)
        </h3>
        <p class="text-xs text-gray-600 mt-0.5 m-0">
          O Percurso 01-02 permite integralizar 300h em pacotes curriculares certificados em outros departamentos da UFMG ou em grandes áreas temáticas institucionais.
        </p>
      </div>
      <span class="px-2.5 py-1 rounded bg-[#005A9C] text-white font-mono text-xs font-bold self-start sm:self-auto shrink-0">
        300 Horas / 20 Créditos
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Card FCA -->
      <div class="p-4 bg-[#F7F5F0] border border-[#DFDBD2] rounded-xl space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-8 h-8 rounded-lg bg-[#005A9C] text-white flex items-center justify-center text-base">
              <i class="bi bi-grid-3x3-gap-fill" aria-hidden="true" />
            </span>
            <h4 class="font-['Oswald'] text-sm uppercase font-bold text-[#0A0A0A] m-0">
              Formação Complementar Aberta (FCA)
            </h4>
          </div>
          <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-blue-100 text-blue-800">
            Res. 01/2016 e 01/2018
          </span>
        </div>
        <p class="text-xs text-gray-700 leading-relaxed m-0">
          Permite ao estudante de Gestão Pública montar um percurso personalizado de 300 horas cursando disciplinas em faculdades parceiras da UFMG (Direito, FACE/Economia/Administração, ECI/Ciência da Informação, ICEx, Belas Artes, etc.), mediante aprovação prévia de plano de estudos pelo Colegiado.
        </p>
        <div class="pt-2 border-t border-[#DFDBD2] flex flex-wrap gap-2">
          <a
            href={asset('/documentos/fca-formacao-complementar-aberta.pdf')}
            download
            class="min-h-[36px] px-3 py-1.5 bg-white hover:bg-[#005A9C] hover:text-white border border-[#DFDBD2] rounded-lg text-xs font-mono font-bold text-[#0A0A0A] inline-flex items-center gap-1.5 transition-colors no-underline shadow-xs"
          >
            <i class="bi bi-file-earmark-pdf text-[#005A9C]" aria-hidden="true" />
            <span>Guia FCA (PDF - 62 KB)</span>
          </a>
          <a
            href={asset('/documentos/requerimento-formacao-complementar-aberta-fca.pdf')}
            download
            class="min-h-[36px] px-3 py-1.5 bg-[#005A9C] hover:bg-[#0A0A0A] text-white rounded-lg text-xs font-mono font-bold inline-flex items-center gap-1.5 transition-colors no-underline shadow-xs"
          >
            <i class="bi bi-pencil-square" aria-hidden="true" />
            <span>Requerimento FCA (PDF - 90 KB)</span>
          </a>
          <a
            href={asset('/documentos/resolucao-01-2016-formacao-complementar-aberta.pdf')}
            download
            class="min-h-[36px] px-3 py-1.5 bg-white hover:bg-[#0A0A0A] hover:text-white border border-[#DFDBD2] rounded-lg text-xs font-mono font-bold text-[#0A0A0A] inline-flex items-center gap-1.5 transition-colors no-underline shadow-xs"
          >
            <i class="bi bi-file-earmark-text" aria-hidden="true" />
            <span>Resolução 01/2016 (PDF)</span>
          </a>
          <a
            href={asset('/documentos/resolucao-01-2018-altera-formacao-complementar-aberta.pdf')}
            download
            class="min-h-[36px] px-3 py-1.5 bg-white hover:bg-[#0A0A0A] hover:text-white border border-[#DFDBD2] rounded-lg text-xs font-mono font-bold text-[#0A0A0A] inline-flex items-center gap-1.5 transition-colors no-underline shadow-xs"
          >
            <i class="bi bi-file-earmark-text" aria-hidden="true" />
            <span>Resolução 01/2018 (PDF)</span>
          </a>
        </div>
      </div>

      <!-- Card Formação Transversal -->
      <div class="p-4 bg-[#F7F5F0] border border-[#DFDBD2] rounded-xl space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-8 h-8 rounded-lg bg-[#15803D] text-white flex items-center justify-center text-base">
              <i class="bi bi-intersect" aria-hidden="true" />
            </span>
            <h4 class="font-['Oswald'] text-sm uppercase font-bold text-[#0A0A0A] m-0">
              Formações Transversais da UFMG
            </h4>
          </div>
          <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-green-100 text-green-800">
            Res. CEPE 19/2014
          </span>
        </div>
        <p class="text-xs text-gray-700 leading-relaxed m-0">
          Formações interdisciplinares temáticas estruturadas pela Pró-Reitoria de Graduação (PROGRAD): <em>Direitos Humanos</em>, <em>Relações Étnico-Raciais e Gênero</em>, <em>Meio Ambiente e Sustentabilidade</em>, <em>Divulgação Científica</em>, entre outras. Garantem certificação complementar no histórico escolar.
        </p>
        <div class="pt-2 border-t border-[#DFDBD2] flex flex-wrap gap-2">
          <a
            href={asset('/documentos/resolucao-cepe-19-2014-formacao-transversal.pdf')}
            download
            class="min-h-[36px] px-3 py-1.5 bg-white hover:bg-[#15803D] hover:text-white border border-[#DFDBD2] rounded-lg text-xs font-mono font-bold text-[#0A0A0A] inline-flex items-center gap-1.5 transition-colors no-underline shadow-xs"
          >
            <i class="bi bi-file-earmark-pdf text-[#15803D]" aria-hidden="true" />
            <span>Resolução CEPE 19/2014 - Formação Transversal (PDF - 198 KB)</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Formação Livre (120h) & Pós-Graduação (PPGCP) -->
  <div class="p-4 sm:p-5 bg-white border border-[#DFDBD2] rounded-xl space-y-4 shadow-xs">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-[#DFDBD2] pb-3">
      <div>
        <span class="text-[11px] font-['Oswald'] uppercase font-bold tracking-wider text-[#B45309]">
          PPC Art. 13 & Regulamento Art. 3º
        </span>
        <h3 class="font-['Oswald'] text-base font-bold uppercase text-[#0A0A0A] m-0">
          Formação Livre (120h) & Matrícula na Pós-Graduação (PPGCP)
        </h3>
        <p class="text-xs text-gray-600 mt-0.5 m-0">
          Documentos e requerimentos para cursar disciplinas fora da FAFICH ou disciplinas adiantadas de mestrado/doutorado.
        </p>
      </div>
      <span class="px-2.5 py-1 rounded bg-[#B45309] text-white font-mono text-xs font-bold self-start sm:self-auto shrink-0">
        120h Livre • Até 120h Pós
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="p-4 bg-[#F7F5F0] border border-[#DFDBD2] rounded-xl space-y-3">
        <div class="flex items-center gap-3">
          <span class="w-9 h-9 rounded-lg bg-[#B45309]/15 text-[#B45309] flex items-center justify-center text-lg shrink-0 border border-[#B45309]/30">
            <i class="bi bi-plus-slash-minus" aria-hidden="true" />
          </span>
          <div>
            <h4 class="font-['Oswald'] text-xs uppercase font-bold text-[#0A0A0A] m-0">
              Formação Livre (120h • 8 Créditos)
            </h4>
            <p class="text-xs text-gray-600 m-0">
              Direito regulamentar garantido a todo discente no PPC Art. 13.
            </p>
          </div>
        </div>
        <p class="text-xs text-gray-700 leading-relaxed m-0">
          Você tem direito a cursar até 120 horas em qualquer departamento da UFMG (Direito, Economia, Ciência da Informação, Engenharia, Belas Artes, etc.). Matrícula realizada na 3ª Fase do SIGA ou por acerto com o formulário oficial.
        </p>
        <div class="pt-2 border-t border-[#DFDBD2] flex flex-wrap gap-2">
          <a
            href={asset('/documentos/requerimento-matricula-formacao-livre.pdf')}
            download
            class="min-h-[36px] px-3 py-1.5 bg-[#B45309] hover:bg-[#0A0A0A] text-white rounded-lg text-xs font-mono font-bold inline-flex items-center gap-1.5 transition-colors no-underline shadow-xs"
          >
            <i class="bi bi-file-earmark-pdf" aria-hidden="true" />
            <span>Requerimento de Formação Livre (PDF - 95 KB)</span>
          </a>
          <a
            href="#grafo"
            class="min-h-[36px] px-3 py-1.5 bg-white hover:bg-[#0A0A0A] hover:text-white border border-[#DFDBD2] rounded-lg text-xs font-['Oswald'] uppercase font-bold text-[#0A0A0A] inline-flex items-center gap-1.5 transition-colors no-underline"
          >
            <i class="bi bi-pencil-square text-[#B45309]" aria-hidden="true" />
            <span>Inserir no Grafo 10P</span>
          </a>
        </div>
      </div>

      <div class="p-4 bg-[#F7F5F0] border border-[#DFDBD2] rounded-xl space-y-3">
        <div class="flex items-center gap-3">
          <span class="w-9 h-9 rounded-lg bg-[#005A9C]/15 text-[#005A9C] flex items-center justify-center text-lg shrink-0 border border-[#005A9C]/30">
            <i class="bi bi-mortarboard-fill" aria-hidden="true" />
          </span>
          <div>
            <h4 class="font-['Oswald'] text-xs uppercase font-bold text-[#0A0A0A] m-0">
              Matrícula na Pós-Graduação (PPGCP)
            </h4>
            <p class="text-xs text-gray-600 m-0">
              Percurso 01-03 (Núcleo Avançado) ou disciplinas isoladas de mestrado.
            </p>
          </div>
        </div>
        <p class="text-xs text-gray-700 leading-relaxed m-0">
          Discentes de alto rendimento a partir do 7º período podem requerer autorização do Colegiado e da Coordenação do PPGCP para cursar disciplinas do mestrado, com aproveitamento integral para futura pós-graduação.
        </p>
        <div class="pt-2 border-t border-[#DFDBD2] flex flex-wrap gap-2">
          <a
            href={asset('/documentos/requerimento-matricula-pos-graduacao.pdf')}
            download
            class="min-h-[36px] px-3 py-1.5 bg-[#005A9C] hover:bg-[#0A0A0A] text-white rounded-lg text-xs font-mono font-bold inline-flex items-center gap-1.5 transition-colors no-underline shadow-xs"
          >
            <i class="bi bi-file-earmark-pdf" aria-hidden="true" />
            <span>Requerimento Matrícula Pós (PDF - 228 KB)</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
