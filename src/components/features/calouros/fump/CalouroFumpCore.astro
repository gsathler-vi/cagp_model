---
// src/components/features/calouros/fump/CalouroFumpCore.astro — Permanência e Assistência Estudantil (FUMP & PRAE)
import { asset } from '../../../../lib/paths';

const niveis = [
  {
    nivel: 'Nível I',
    status: 'Extrema Vulnerabilidade',
    beneficios: 'Isenção integral de todas as refeições no RU (café da manhã, almoço e jantar), prioridade máxima em bolsas acadêmicas (PIBIC, Extensão, Monitoria) e auxílio moradia ou vaga nas Moradias Universitárias.',
    badge: 'Isenção 100% RU',
    highlight: true,
  },
  {
    nivel: 'Nível II',
    status: 'Alta Vulnerabilidade',
    beneficios: 'Subsídio ampliado de alimentação em todas as refeições, auxílio financeiro de permanência, suporte para aquisição de material didático e assistência à saúde integral.',
    badge: 'Subsídio Ampliado',
    highlight: true,
  },
  {
    nivel: 'Nível III',
    status: 'Média Vulnerabilidade',
    beneficios: 'Subsídio parcial de alimentação, acesso ao café da manhã exclusivo no Setorial I e elegibilidade para editais de fomento e auxílios emergenciais.',
    badge: 'Subsídio Parcial',
    highlight: false,
  },
  {
    nivel: 'Estudantes em Geral',
    status: 'Padrão Discente UFMG',
    beneficios: 'Acesso regular a todas as refeições de almoço e jantar pelo valor fixo subsidiado discente padrão da UFMG, além do atendimento de saúde clínica e odontológica da FUMP.',
    badge: 'Tarifa Discente',
    highlight: false,
  },
];

const contatosFump = [
  { unidade: 'Belo Horizonte (Sede Pampulha)', telefones: '(31) 3409-8401 / 3409-8470', whatsapp: '(31) 97537-0115', email: 'atendimento@fump.ufmg.br' },
  { unidade: 'Montes Claros (Campus ICA)', telefones: '(38) 3213-9867', whatsapp: '(31) 98411-6181', email: 'fumpica@fump.ufmg.br' },
];

const docsPrae = [
  { titulo: 'Portaria PRAE nº 1.286/2026', desc: 'Política de Permanência Estudantil, critérios socioeconômicos e regras de RU.', file: 'portaria-prae-1286-2026-permanencia-estudantil.pdf' },
  { titulo: 'Resolução nº 07/2025 (Contra o Assédio)', desc: 'Política institucional de enfrentamento e prevenção a violências.', file: 'resolucao-ufmg-07-2025-contra-o-assedio.pdf' },
  { titulo: 'Resolução PRAE nº 09/2015 (Nome Social)', desc: 'Garantia institucional de uso do nome social em registros e carteirinha.', file: 'resolucao-prae-09-2015-nome-social.pdf' },
];
---

<div class="cagp-calouro-fump space-y-6 select-none text-[#0A0A0A]">
  {/* Cabeçalho */}
  <div class="p-4 bg-white border border-[#DFDBD2] rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-xs">
    <div>
      <span class="text-[11px] font-['Oswald'] uppercase font-bold tracking-wider text-[#15803D]">
        Permanência e Apoio Discente • Portaria PRAE nº 1.286/2026
      </span>
      <h3 class="font-['Oswald'] text-base font-bold uppercase text-[#0A0A0A] m-0">
        Assistência Estudantil FUMP & PRAE/UFMG
      </h3>
      <p class="text-xs text-gray-600 mt-0.5 m-0">
        Diretrizes da Pró-Reitoria de Assuntos Estudantis e serviços operacionais da Fundação Mendes Pimentel.
      </p>
    </div>

    <div class="flex items-center gap-2 shrink-0">
      <a
        href="https://www.fump.ufmg.br/"
        target="_blank"
        rel="noopener noreferrer"
        class="min-h-[40px] px-3.5 py-2 bg-[#15803D] hover:bg-[#0A0A0A] text-white rounded-lg text-xs font-['Oswald'] uppercase font-bold tracking-wider flex items-center justify-center gap-1.5 transition-all no-underline shadow-[2px_2px_0px_#0A0A0A]"
      >
        <i class="bi bi-box-arrow-up-right" aria-hidden="true" />
        <span>Área do Aluno FUMP</span>
      </a>
    </div>
  </div>

  {/* Classificação Socioeconômica (Níveis I a III) */}
  <div class="space-y-3">
    <div class="border-b border-[#DFDBD2] pb-1.5 flex items-center justify-between">
      <span class="font-['Oswald'] text-xs font-bold uppercase text-[#0A0A0A]">
        Níveis de Vulnerabilidade Socioeconômica (Portaria PRAE 1.286/2026)
      </span>
      <span class="text-xs font-mono text-gray-500">Estudo Social FUMP</span>
    </div>

    {niveis.map((n) => (
      <div
        class={`cagp-card p-3.5 rounded-xl border flex flex-col sm:flex-row sm:items-center justify-between gap-3 transition-all ${
          n.highlight
            ? 'bg-[#F0FDF4] border-[#15803D] shadow-[2px_2px_0px_#15803D]'
            : 'bg-white border-[#DFDBD2]'
        }`}
      >
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-2 mb-1 flex-wrap">
            <h4 class="font-['Oswald'] text-sm font-bold uppercase text-[#0A0A0A] m-0">
              {n.nivel}
            </h4>
            <span class="text-xs text-gray-500 font-medium">— {n.status}</span>
            <span class={`px-2 py-0.5 rounded text-[10px] font-['Oswald'] uppercase font-bold ${
              n.highlight ? 'bg-[#15803D] text-white' : 'bg-gray-100 text-gray-700 border border-[#DFDBD2]'
            }`}>
              {n.badge}
            </span>
          </div>
          <p class="text-xs text-gray-700 leading-relaxed m-0">
            {n.beneficios}
          </p>
        </div>
      </div>
    ))}
  </div>

  {/* Restaurantes Universitários: Locais e Horários Oficiais */}
  <div class="p-4 bg-[#F7F5F0] border border-[#DFDBD2] rounded-xl space-y-3 shadow-xs">
    <div class="flex items-center justify-between border-b border-[#DFDBD2] pb-2">
      <h4 class="font-['Oswald'] text-sm font-bold uppercase text-[#0A0A0A] m-0 flex items-center gap-2">
        <i class="bi bi-clock-history text-[#8B1E2D]" aria-hidden="true" />
        <span>Restaurantes Universitários (RU): Locais e Horários no Campus Pampulha</span>
      </h4>
      <span class="cagp-badge cagp-badge-red text-xs font-mono">Outubro 2026</span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
      <div class="p-3 bg-white border border-[#DFDBD2] rounded-lg space-y-1">
        <span class="cagp-badge cagp-badge-gold text-[10px] font-mono">06h40 – 08h15</span>
        <strong class="font-['Oswald'] uppercase text-xs block text-[#0A0A0A] mt-1">Café da Manhã</strong>
        <p class="text-xs text-gray-600 m-0">Servido exclusivamente no <strong>RU Setorial I</strong>. Destinado aos discentes nos Níveis I, II e III.</p>
      </div>

      <div class="p-3 bg-white border border-[#DFDBD2] rounded-lg space-y-1">
        <span class="cagp-badge cagp-badge-green text-[10px] font-mono">11h00 – 14h00</span>
        <strong class="font-['Oswald'] uppercase text-xs block text-[#0A0A0A] mt-1">Almoço Regular</strong>
        <p class="text-xs text-gray-600 m-0">Servido normalmente tanto no <strong>RU Setorial I</strong> quanto no <strong>RU Setorial II</strong> para toda a comunidade.</p>
      </div>

      <div class="p-3 bg-white border-2 border-[#8B1E2D] rounded-lg space-y-1 shadow-[2px_2px_0px_#8B1E2D]">
        <span class="cagp-badge cagp-badge-red text-[10px] font-mono">17h10 – 19h30</span>
        <strong class="font-['Oswald'] uppercase text-xs block text-[#8B1E2D] mt-1">Jantar Noturno</strong>
        <p class="text-xs text-gray-700 m-0">Servido exclusivamente no <strong>RU Setorial II</strong> (próximo ao ICB). Atende todos os estudantes matriculados.</p>
      </div>
    </div>
  </div>

  {/* Saúde do Estudante: DAST & DASE */}
  <div class="p-4 bg-white border border-[#DFDBD2] rounded-xl space-y-3 shadow-xs">
    <div class="flex items-center justify-between border-b border-[#DFDBD2] pb-2">
      <h4 class="font-['Oswald'] text-sm font-bold uppercase text-[#0A0A0A] m-0 flex items-center gap-2">
        <i class="bi bi-heart-pulse-fill text-[#DC2626]" aria-hidden="true" />
        <span>Saúde Integral e Apoio Psicossocial (DAST & DASE/PRAE)</span>
      </h4>
      <span class="text-xs text-gray-500 font-mono">Apoio Gratuito</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-center">
      <div class="space-y-2 text-xs text-gray-700">
        <p class="leading-relaxed m-0">
          A UFMG dispõe de atendimento médico, odontológico e psicológico especializado para os estudantes da graduação:
        </p>
        <ul class="space-y-1.5 pl-4 list-disc text-gray-600">
          <li><strong>DASE/PRAE:</strong> Espaço de Escuta e Acolhimento Psicológico para manejo de estresse acadêmico (<span class="font-mono text-[#8B1E2D]">dase@prae.ufmg.br</span>).</li>
          <li><strong>DAST:</strong> Divisão de Atenção à Saúde com consultas clínicas gratuitas na sede da FUMP no campus.</li>
          <li><strong>Urgência no Campus:</strong> SAMU 192 ou acionamento imediato via vigilância interna pelo ramal <span class="font-mono font-bold">3409-4444</span>.</li>
        </ul>
      </div>

      <div class="rounded-lg border border-[#DFDBD2] overflow-hidden bg-white shadow-xs">
        <img
          src={asset('/imagens/dast-novo-bh.jpg')}
          alt="Infográfico oficial dos serviços de atenção à saúde da DAST / UFMG"
          class="w-full h-auto max-h-[220px] object-cover"
          loading="lazy"
        />
      </div>
    </div>
  </div>

  {/* Infográfico Passo a Passo FUMP */}
  <div class="p-4 bg-white border border-[#DFDBD2] rounded-xl space-y-3 shadow-xs">
    <div class="flex items-center justify-between border-b border-[#DFDBD2] pb-2 flex-wrap gap-2">
      <div>
        <h4 class="font-['Oswald'] text-sm font-bold uppercase text-[#0A0A0A] m-0 flex items-center gap-2">
          <i class="bi bi-card-checklist text-[#8B1E2D]" aria-hidden="true" />
          <span>Passo a Passo: Como Acessar a Assistência Estudantil FUMP</span>
        </h4>
        <p class="text-xs text-gray-600 mt-0.5 m-0">Fluxo oficial para preenchimento do questionário socioeconômico:</p>
      </div>
      <a
        href={asset('/imagens/passo-a-passo-assistencia-fump.jpg')}
        target="_blank"
        rel="noopener noreferrer"
        class="cagp-btn-secondary text-xs py-1.5 px-3 no-underline shrink-0 flex items-center gap-1.5"
      >
        <i class="bi bi-arrows-fullscreen"></i> Ampliar Infográfico
      </a>
    </div>

    <div class="rounded-[8px] border-2 border-[#0A0A0A] shadow-[2px_2px_0px_#0A0A0A] overflow-hidden bg-white">
      <img
        src={asset('/imagens/passo-a-passo-assistencia-fump.jpg')}
        alt="Infográfico oficial da FUMP com o passo a passo de acesso ao Questionário Socioeconômico na Área do Aluno"
        class="w-full h-auto max-h-[460px] object-contain mx-auto"
        loading="lazy"
      />
    </div>
  </div>

  {/* Canais Oficiais de Contato FUMP */}
  <div class="p-4 bg-[#F7F5F0] border border-[#DFDBD2] rounded-xl space-y-3 shadow-xs">
    <div class="flex items-center justify-between border-b border-[#DFDBD2] pb-2">
      <h4 class="font-['Oswald'] text-sm font-bold uppercase text-[#0A0A0A] m-0 flex items-center gap-2">
        <i class="bi bi-telephone-fill text-[#15803D]" aria-hidden="true" />
        <span>Canais de Atendimento e WhatsApp da FUMP</span>
      </h4>
      <span class="text-xs text-gray-500 font-mono">Atendimento Direto</span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
      {contatosFump.map((c) => (
        <div class="p-3 bg-white border border-[#DFDBD2] rounded-lg space-y-1">
          <strong class="font-['Oswald'] uppercase text-xs block text-[#0A0A0A]">{c.unidade}</strong>
          <p class="text-xs text-gray-700 m-0"><strong>Telefone:</strong> <span class="font-mono">{c.telefones}</span></p>
          <p class="text-xs text-gray-700 m-0"><strong>WhatsApp Oficial:</strong> <span class="font-mono text-[#15803D] font-bold">{c.whatsapp}</span></p>
          <p class="text-xs text-gray-700 m-0"><strong>E-mail:</strong> <span class="font-mono">{c.email}</span></p>
        </div>
      ))}
    </div>
  </div>

  {/* Anexos de Documentos Oficiais PRAE / FUMP */}
  <div class="p-4 bg-white border border-[#DFDBD2] rounded-xl space-y-3 shadow-xs">
    <div class="flex items-center justify-between border-b border-[#DFDBD2] pb-2">
      <h4 class="font-['Oswald'] text-sm font-bold uppercase text-[#0A0A0A] m-0 flex items-center gap-2">
        <i class="bi bi-file-earmark-pdf-fill text-[#8B1E2D]" aria-hidden="true" />
        <span>Documentos e Resoluções Oficiais da Assistência Estudantil</span>
      </h4>
      <span class="text-xs text-gray-500 font-mono">Downloads</span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      {docsPrae.map((d) => (
        <div class="p-3 bg-[#F7F5F0] border border-[#DFDBD2] rounded-lg flex flex-col justify-between">
          <div>
            <h5 class="font-['Oswald'] font-bold text-xs uppercase text-[#0A0A0A] m-0 mb-1">{d.titulo}</h5>
            <p class="text-[11px] text-gray-600 leading-snug m-0">{d.desc}</p>
          </div>
          <div class="mt-3 pt-2 border-t border-[#DFDBD2]">
            <a
              href={asset(`/documentos/${d.file}`)}
              download
              class="cagp-btn-primary text-xs py-1.5 px-2.5 no-underline flex items-center justify-center gap-1.5 w-full"
              title={`Baixar ${d.titulo}`}
            >
              <i class="bi bi-download" aria-hidden="true" />
              <span>Baixar PDF</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>
