---
// CampaignBanner.astro - Faixa Permanente de Transparência e Proposta da Chapa Semente (Cores: Laranja #FF8718, Roxo #5B2E85, Verde #2A6264)
import { asset } from '../../lib/paths';
---

<aside
  id="cagp-campaign-banner"
  transition:persist="campaign-banner"
  class="w-full bg-[#5B2E85] text-white border-b border-black/15 select-none text-xs transition-all duration-200 z-[1050] relative shadow-sm"
>
  <!-- Micro-faixa Tricolor de Identidade da Chapa Semente -->
  <div class="h-[3px] w-full flex" aria-hidden="true">
    <div class="h-full w-1/3 bg-[#FF8718]"></div>
    <div class="h-full w-1/3 bg-[#5B2E85]"></div>
    <div class="h-full w-1/3 bg-[#2A6264]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-3 sm:px-4 py-1.5 sm:py-2.5 flex items-center justify-between gap-2 sm:gap-3">
    <div class="flex items-center gap-2 sm:gap-3 flex-1 min-w-0">
      <!-- Logo Oficial da Chapa Semente em Destaque Visual Amplo -->
      <div class="w-9 h-9 sm:w-12 sm:h-12 rounded-[6px] overflow-hidden border border-black/15 shadow-xs shrink-0 bg-[#FF8718] flex items-center justify-center p-0.5">
        <img
          src={asset('/logos/semente_logo_fundo_laranja.png')}
          alt="Logo Oficial da Chapa Semente"
          class="w-full h-full object-contain rounded-[4px]"
          loading="eager"
        />
      </div>

      <div class="flex flex-col gap-0.5 flex-1 min-w-0">
        <div class="flex items-center gap-1.5 flex-wrap">
          <!-- Badge Principal: Chapa Semente -->
          <span class="inline-flex items-center font-['Oswald'] text-[11px] sm:text-xs font-bold tracking-wider uppercase bg-[#FF8718] text-[#0A0A0A] px-2 py-0.5 rounded-[4px] border border-black/15 shadow-xs shrink-0">
            CHAPA SEMENTE
          </span>

          <!-- Badge Secundário: Verde Petróleo da Chapa -->
          <span class="hidden sm:inline-flex items-center font-['Oswald'] text-[11px] font-bold uppercase bg-[#2A6264] text-white px-2 py-0.5 rounded-[4px] border border-white/20 shrink-0">
            PROPOSTA DE GESTÃO
          </span>
        </div>

        <!-- Texto Oficial com Destaque WCAG AAA -->
        <p id="cagp-banner-text" class="text-[11px] sm:text-xs text-white/95 leading-snug m-0 line-clamp-1 transition-all">
          Este portal é uma proposta e projeto da <strong class="text-[#FFA347] font-bold">Chapa Semente</strong> para a gestão do <strong>CAGP (FAFICH/UFMG)</strong>. Nosso compromisso é com os discentes: <strong>independentemente do resultado da eleição, disponibilizaremos este projeto completo para a gestão vencedora</strong>.
        </p>
      </div>
    </div>

    <!-- Botão de Alternância Compacto / Expandido -->
    <button
      type="button"
      id="cagp-banner-toggle-btn"
      class="px-3 py-2 min-h-[44px] bg-[#2A6264] hover:bg-[#204e50] active:scale-95 text-white border border-[#FF8718]/60 rounded-[4px] text-[11px] font-mono font-bold shrink-0 flex items-center justify-center gap-1 transition-all cursor-pointer shadow-xs"
      aria-expanded="false"
      aria-controls="cagp-banner-text"
      title="Alternar modo compacto do aviso da Chapa Semente"
    >
      <span id="cagp-banner-toggle-label">Expandir ▼</span>
    </button>
  </div>
</aside>

<script>
  function setupCampaignBanner() {
    const banner = document.getElementById('cagp-campaign-banner');
    const text = document.getElementById('cagp-banner-text');
    const btn = document.getElementById('cagp-banner-toggle-btn');
    const label = document.getElementById('cagp-banner-toggle-label');
    if (!banner || !text || !btn || !label) return;

    let isExpanded = localStorage.getItem('cagp_campaign_banner_expanded') === 'true';

    function renderState() {
      if (isExpanded) {
        text?.classList.remove('line-clamp-1');
        label.textContent = 'Compactar ▲';
        btn?.setAttribute('aria-expanded', 'true');
      } else {
        text?.classList.add('line-clamp-1');
        label.textContent = 'Expandir ▼';
        btn?.setAttribute('aria-expanded', 'false');
      }
    }

    btn.addEventListener('click', () => {
      isExpanded = !isExpanded;
      localStorage.setItem('cagp_campaign_banner_expanded', isExpanded ? 'true' : 'false');
      renderState();
    });

    renderState();
  }

  document.addEventListener('astro:page-load', setupCampaignBanner);
</script>
