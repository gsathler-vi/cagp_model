---
// SuperAppHeader.astro - Topbar em Pílula Flutuante (Apple HIG + Neo-Brutalista CAGP)
import { HEADER_NAV_ITEMS } from './headerNavData';
import { asset, route } from '../../lib/paths';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHomeActive = currentPath === '/' || currentPath === '';
---

<header
  id="cagp-super-app-header"
  class="sticky top-2 sm:top-3 lg:top-4 z-[1040] w-full max-w-full px-2 sm:px-4 lg:px-6 pointer-events-none select-none transition-all duration-300"
  style="padding-top: env(safe-area-inset-top, 0px);"
>
  <div class="max-w-7xl mx-auto flex items-center justify-between gap-1.5 sm:gap-4 pointer-events-none">
    <!-- ILHA 1: Marca & Identidade Institucional (Esquerda) -->
    <div class="pointer-events-auto bg-white/95 backdrop-blur-xl border border-black/15 shadow-sm rounded-full px-2.5 py-1 sm:px-4 sm:py-2 flex items-center shrink min-w-0 transition-transform active:scale-98">
      <a href={route('/')} class="flex items-center gap-2 sm:gap-2.5 text-inherit no-underline min-h-[44px] group min-w-0" aria-label="Página Inicial CAGP">
        <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-white flex items-center justify-center p-1 border border-black/15 shadow-xs group-hover:rotate-6 transition-transform shrink-0">
          <img src={asset('/logos/cagp/10_simbolo_transparente_positivo.svg')} alt="Emblema Candangos CAGP" class="w-full h-full object-contain" />
        </div>
        <div class="leading-tight min-w-0">
          <span class="block font-['Oswald'] font-black text-xs sm:text-base tracking-wide uppercase whitespace-nowrap text-[#8B1E2D]">
            CAGP
          </span>
        </div>
      </a>
    </div>

    <!-- ILHA 2: Doca Central dos 5 Eixos (Centro - Desktop) -->
    <nav class="hidden lg:flex pointer-events-auto bg-white/95 backdrop-blur-xl border border-black/15 shadow-sm rounded-full p-1.5 items-center gap-1.5 xl:gap-2 transition-all mx-auto" aria-label="Navegação desktop dos 5 eixos">
      <!-- 1. Início -->
      <a
        href={route('/')}
        class={`cagp-island-nav-link px-3.5 py-1.5 rounded-full font-['Inter'] font-semibold text-xs transition-all no-underline min-h-[44px] flex items-center gap-2 border whitespace-nowrap ${
          isHomeActive
            ? 'is-active bg-[#8B1E2D] text-white border-black/15 shadow-xs'
            : 'text-gray-700 border-transparent hover:bg-[#F7F5F0] hover:text-[#8B1E2D]'
        }`}
        data-route="/"
        aria-current={isHomeActive ? 'page' : undefined}
      >
        <i class={`bi bi-compass text-sm ${isHomeActive ? 'text-white' : 'text-[#8B1E2D]'}`} aria-hidden="true" />
        <span>Início</span>
      </a>

      <!-- 2 a 5. Dropdowns dos 4 Eixos -->
      {HEADER_NAV_ITEMS.filter(item => item.children).map((item, idx) => {
        const isAxisActive = item.href === currentPath || (item.children && item.children.some(c => c.href === currentPath || (currentPath === '/estagio-tcc' && c.href === '/estagio')));

        return (
          <div class="cagp-island-dropdown relative" data-dropdown={item.href}>
            <button
              type="button"
              class={`cagp-island-dropdown-btn px-3 py-1.5 rounded-full font-['Inter'] font-semibold text-xs flex items-center gap-1.5 xl:gap-2 transition-all min-h-[44px] cursor-pointer border whitespace-nowrap ${
                isAxisActive
                  ? 'is-active bg-[#8B1E2D] text-white border-black/15 shadow-xs'
                  : 'text-gray-700 border-transparent hover:bg-[#F7F5F0] hover:text-[#8B1E2D]'
              }`}
              aria-expanded="false"
              aria-haspopup="true"
            >
              <i class={`bi ${item.icon} text-sm ${isAxisActive ? 'text-white' : 'text-gray-500'}`} aria-hidden="true" />
              <span class="xl:hidden">{item.shortLabel || item.label}</span>
              <span class="hidden xl:inline">{item.label}</span>
              <i class={`bi bi-chevron-down text-[9px] cagp-island-dropdown-chevron ml-0.5 ${isAxisActive ? 'text-white' : 'text-gray-400'}`} aria-hidden="true" />
            </button>
            <div class={`cagp-island-dropdown-menu absolute ${
              idx === 0 ? 'left-0' : idx === 3 ? 'right-0' : 'left-1/2 -translate-x-1/2'
            } top-[calc(100%+0.65rem)] z-[1070] min-w-[310px] max-w-[350px]`}>
              <div class="cagp-island-dropdown-card bg-white/98 backdrop-blur-xl border border-black/15 rounded-2xl shadow-xl p-2.5 space-y-1.5">
                <!-- Header do Eixo com Visão Geral -->
                <div class="flex items-center justify-between px-3 py-2 bg-[#F7F5F0] rounded-xl border border-[#DFDBD2]">
                  <div class="flex items-center gap-2 min-w-0">
                    <div class="w-6 h-6 rounded-md bg-[#8B1E2D] text-white flex items-center justify-center text-xs shrink-0 shadow-xs">
                      <i class={`bi ${item.icon}`} aria-hidden="true" />
                    </div>
                    <span class="font-['Oswald'] font-bold text-xs uppercase tracking-wide text-[#0A0A0A] truncate">{item.label}</span>
                  </div>
                  <a
                    href={route(item.href)}
                    class="text-[11px] font-['Inter'] font-bold text-[#8B1E2D] hover:text-[#0A0A0A] flex items-center gap-1 no-underline transition-colors shrink-0 ml-2"
                    aria-label={`Visão Geral de ${item.label}`}
                  >
                    <span>Visão Geral</span>
                    <i class="bi bi-arrow-right text-[10px]" aria-hidden="true" />
                  </a>
                </div>

                <!-- Divisor Sutil -->
                <div class="border-t border-[#DFDBD2] my-1" />

                <!-- Sub-páginas Canônicas -->
                <div class="space-y-1">
                  {item.children?.map((child) => {
                    const isChildActive = child.href === currentPath;
                    return (
                      <a
                        href={route(child.href)}
                        class={`cagp-island-dropdown-item px-3 py-2 rounded-xl hover:bg-[#F7F5F0] flex items-start gap-3 no-underline transition-all block text-left group/item border ${
                          isChildActive
                            ? 'is-active bg-[#FEE2E2] border-[#8B1E2D] shadow-xs'
                            : 'border-transparent hover:border-[#DFDBD2]'
                        }`}
                        data-route={child.href}
                      >
                        <div class={`w-8 h-8 rounded-lg flex items-center justify-center shrink-0 border transition-all ${
                          isChildActive
                            ? 'bg-[#8B1E2D] text-white border-[#8B1E2D]'
                            : 'bg-[#F7F5F0] text-[#8B1E2D] border-[#DFDBD2] group-hover/item:bg-white group-hover/item:border-black/30 group-hover/item:scale-105'
                        }`}>
                          <i class={`bi ${child.icon} text-sm`} aria-hidden="true" />
                        </div>
                        <div class="min-w-0 flex-1">
                          <span class={`font-['Oswald'] font-bold text-xs uppercase block leading-tight ${
                            isChildActive ? 'text-[#8B1E2D]' : 'text-[#0A0A0A] group-hover/item:text-[#8B1E2D]'
                          }`}>{child.label}</span>
                          <span class="text-[11px] text-gray-500 block leading-snug mt-0.5 line-clamp-1">{child.desc}</span>
                        </div>
                      </a>
                    );
                  })}
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </nav>

    <!-- ILHA 3: Ações Rápidas & Ferramentas Discentes (Direita) -->
    <div class="pointer-events-auto bg-white/95 backdrop-blur-xl border border-black/15 shadow-sm sm:shadow-md rounded-full p-1 sm:px-2 sm:py-1.5 flex items-center gap-1 sm:gap-2 shrink-0 transition-all">
      <!-- Spotlight Search Button (BUG-03 fix: hidden min-[1360px]:inline) -->
      <button
        type="button"
        id="cagp-btn-spotlight"
        class="w-11 h-11 min-w-[44px] min-h-[44px] sm:w-auto px-0 sm:px-2.5 rounded-full border border-black/15 hover:border-black/30 bg-[#F7F5F0] hover:bg-white text-xs font-semibold text-gray-700 shadow-xs hover:shadow-sm active:scale-95 transition-all flex items-center justify-center sm:justify-start gap-1.5 cursor-pointer shrink-0"
        aria-label="Buscar no portal (⌘K)"
        title="Buscar no portal (⌘K)"
      >
        <i class="bi bi-search text-xs text-[#8B1E2D]" aria-hidden="true" />
        <span class="hidden min-[1360px]:inline text-xs text-gray-700 font-medium">Buscar</span>
        <kbd class="hidden min-[1360px]:inline-block text-[11px] bg-white border border-[#DFDBD2] rounded px-1.5 py-0.5 font-mono font-bold text-gray-600 shadow-2xs ml-0.5">⌘K</kbd>
      </button>

      <!-- Live Campus & Notification Status Button -->
      <button
        type="button"
        id="cagp-btn-campus"
        class="w-11 h-11 min-w-[44px] min-h-[44px] sm:w-auto px-0 sm:px-2.5 rounded-full border border-black/15 hover:border-black/30 bg-[#F7F5F0] hover:bg-white text-xs font-['Oswald'] uppercase font-bold tracking-wide text-[#0A0A0A] shadow-xs hover:shadow-sm active:scale-95 transition-all flex items-center justify-center sm:justify-start gap-1.5 cursor-pointer relative shrink-0"
        aria-label="Notificações e status do campus (RU & Circular)"
        title="Notificações e status do campus (RU & Circular)"
      >
        <!-- Mobile Icon with Status Badge (Apple HIG Pattern) -->
        <span class="relative flex items-center justify-center sm:hidden" aria-hidden="true">
          <i class="bi bi-bell text-sm text-[#0A0A0A]" />
          <span class="absolute -top-1 -right-1 w-2.5 h-2.5 rounded-full bg-[#15803D] ring-2 ring-white cagp-pulse-indicator" />
        </span>

        <!-- Desktop/Tablet Inline Dot & Label -->
        <span class="hidden sm:inline-block w-2.5 h-2.5 rounded-full bg-[#15803D] cagp-pulse-indicator shrink-0" aria-hidden="true" />
        <span class="hidden min-[1360px]:inline">Campus</span>
        <span class="hidden 2xl:inline text-gray-500 font-normal ml-0.5 font-['Inter'] text-[11px] lowercase">• aberto</span>
      </button>

      <!-- Quick A11y & Dark Mode Fast Toggle -->
      <button
        type="button"
        id="cagp-btn-a11y-quick"
        class="hidden sm:flex w-11 h-11 min-w-[44px] min-h-[44px] items-center justify-center rounded-full bg-[#F7F5F0] hover:bg-white border border-black/15 hover:border-black/30 text-gray-700 hover:text-[#8B1E2D] shadow-xs active:scale-95 transition-all cursor-pointer shrink-0"
        aria-label="Acessibilidade e Modo Noturno (Alt+A)"
        title="Acessibilidade e Modo Noturno (Alt+A)"
      >
        <i class="bi bi-universal-access text-base" aria-hidden="true" />
      </button>

      <!-- Divisor Sutil -->
      <div class="hidden sm:block h-5 w-[1.5px] bg-[#DFDBD2] shrink-0 mx-0.5" aria-hidden="true"></div>

      <!-- Student Passport Avatar -->
      <button
        type="button"
        id="cagp-btn-passport"
        class="w-11 h-11 min-w-[44px] min-h-[44px] flex items-center justify-center rounded-full bg-white border border-black/15 hover:border-black/30 text-[#8B1E2D] hover:bg-[#F7F5F0] shadow-xs active:scale-95 transition-all cursor-pointer overflow-hidden relative shrink-0"
        aria-label="Abrir passaporte discente"
        title="Passaporte Discente"
      >
        <span id="cagp-header-avatar-slot" class="w-full h-full flex items-center justify-center text-xs font-['Oswald'] font-bold">
          <i class="bi bi-person-fill text-base" aria-hidden="true" />
        </span>
      </button>

      <!-- Hamburger Menu Button (Mobile/Tablet: < lg) -->
      <button
        type="button"
        id="cagp-mobile-menu-btn"
        onclick="if(window.__cagp_toggle_drawer){window.__cagp_toggle_drawer()}else{window.dispatchEvent(new CustomEvent('cagp:toggle-drawer'))}"
        class="lg:hidden w-11 h-11 min-w-[44px] min-h-[44px] flex items-center justify-center rounded-full text-[#0A0A0A] hover:bg-[#F7F5F0] hover:text-[#8B1E2D] transition-all cursor-pointer border border-black/15 bg-white shadow-xs active:scale-95 shrink-0"
        aria-label="Abrir menu de navegação lateral com todas as seções"
        title="Menu Geral"
      >
        <i class="bi bi-list text-xl" aria-hidden="true" />
      </button>
    </div>
  </div>
</header>

<style>
  #cagp-super-app-header.is-scrolled::before {
    content: '';
    position: absolute;
    inset: -0.5rem -1rem -0.5rem -1rem;
    background-color: rgba(247, 245, 240, 0.85);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    border-bottom: 1.5px solid var(--color-cagp-border, #DFDBD2);
    z-index: -1;
    border-radius: 0 0 16px 16px;
    pointer-events: none;
  }

</style>

<script>
  import { renderAvatarHtml } from '../../lib/avatarHelper';

  function setupHeaderListeners() {
    const dispatch = (evt: string) => window.dispatchEvent(new CustomEvent(evt));

    const spotlightBtn = document.getElementById('cagp-btn-spotlight');
    if (spotlightBtn) spotlightBtn.onclick = () => dispatch('cagp:open-spotlight');

    const campusBtn = document.getElementById('cagp-btn-campus');
    if (campusBtn) campusBtn.onclick = () => dispatch('cagp:open-campus');

    const a11yQuickBtn = document.getElementById('cagp-btn-a11y-quick');
    if (a11yQuickBtn) a11yQuickBtn.onclick = () => dispatch('cagp:open-a11y');

    const passportBtn = document.getElementById('cagp-btn-passport');
    if (passportBtn) passportBtn.onclick = () => dispatch('cagp:open-passport');

    const mobileMenuBtn = document.getElementById('cagp-mobile-menu-btn');
    if (mobileMenuBtn) {
      mobileMenuBtn.onclick = (e) => {
        e.stopPropagation();
        if ((window as any).__cagp_toggle_drawer) {
          (window as any).__cagp_toggle_drawer();
        } else {
          dispatch('cagp:toggle-drawer');
        }
      };
    }

    // Cortina Liquid Glass contínua no scroll (BUG-04)
    const headerEl = document.getElementById('cagp-super-app-header');
    const handleHeaderScroll = () => {
      if (headerEl) {
        headerEl.classList.toggle('is-scrolled', window.scrollY > 16);
      }
    };
    window.addEventListener('scroll', handleHeaderScroll, { passive: true });
    handleHeaderScroll();

    // Dropdowns interativos (Desktop)
    const dropdowns = document.querySelectorAll<HTMLElement>('.cagp-island-dropdown');

    dropdowns.forEach((dd) => {
      const btn = dd.querySelector<HTMLButtonElement>('.cagp-island-dropdown-btn');
      if (!btn) return;

      btn.onclick = (e) => {
        e.stopPropagation();
        const isOpen = dd.classList.contains('is-open');

        dropdowns.forEach((d) => {
          d.classList.remove('is-open');
          d.querySelector('.cagp-island-dropdown-btn')?.setAttribute('aria-expanded', 'false');
        });

        if (!isOpen) {
          dd.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
        }
      };

      // Navegação por setas (ArrowDown / ArrowUp)
      dd.addEventListener('keydown', (e) => {
        if (!dd.classList.contains('is-open')) return;
        const items = Array.from(dd.querySelectorAll<HTMLAnchorElement>('.cagp-island-dropdown-item'));
        if (items.length === 0) return;
        const activeEl = document.activeElement as HTMLAnchorElement;
        const currentIndex = items.indexOf(activeEl);

        if (e.key === 'ArrowDown') {
          e.preventDefault();
          const nextIndex = currentIndex < items.length - 1 ? currentIndex + 1 : 0;
          items[nextIndex]?.focus();
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          const prevIndex = currentIndex > 0 ? currentIndex - 1 : items.length - 1;
          items[prevIndex]?.focus();
        }
      });
    });

    // Fechar dropdowns ao clicar fora
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target?.closest('.cagp-island-dropdown')) {
        dropdowns.forEach((d) => {
          d.classList.remove('is-open');
          d.querySelector('.cagp-island-dropdown-btn')?.setAttribute('aria-expanded', 'false');
        });
      }
    });

    // Atalhos Globais e Tecla Esc (vinculados uma única vez ao window)
    if (!(window as any).__cagp_header_events_bound) {
      (window as any).__cagp_header_events_bound = true;
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          document.querySelectorAll('.cagp-island-dropdown.is-open').forEach((d) => {
            d.classList.remove('is-open');
            d.querySelector('.cagp-island-dropdown-btn')?.setAttribute('aria-expanded', 'false');
          });
        } else if (e.altKey && (e.key === 'a' || e.key === 'A')) {
          e.preventDefault();
          window.dispatchEvent(new CustomEvent('cagp:open-a11y'));
        } else if (e.altKey && (e.key === 's' || e.key === 'S')) {
          e.preventDefault();
          window.dispatchEvent(new CustomEvent('cagp:open-settings'));
        }
      });
      window.addEventListener('cagp:vault-updated', () => {
        (window as any).__cagp_update_avatar?.();
      });
    }

    // Sincronizar Rota Ativa no Cabeçalho
    const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
    const homeLink = document.querySelector<HTMLAnchorElement>('.cagp-island-nav-link');
    if (homeLink) {
      const isHome = currentPath === '/' || currentPath === '';
      homeLink.classList.toggle('is-active', isHome);
      if (isHome) homeLink.setAttribute('aria-current', 'page');
      else homeLink.removeAttribute('aria-current');
    }

    dropdowns.forEach((dd) => {
      const items = dd.querySelectorAll<HTMLAnchorElement>('.cagp-island-dropdown-item');
      let parentActive = false;
      items.forEach((item) => {
        const rawHref = item.getAttribute('href') || '';
        const hrefPath = rawHref.split('#')[0].replace(/\/$/, '') || '/';
        const isMatch = hrefPath === currentPath || (currentPath === '/estagio-tcc' && hrefPath === '/estagio');
        item.classList.toggle('is-active', isMatch);
        if (isMatch) parentActive = true;
      });

      const btn = dd.querySelector<HTMLButtonElement>('.cagp-island-dropdown-btn');
      if (btn) {
        btn.classList.toggle('is-active', parentActive);
      }
    });

    // Sincronizar Avatar do Passaporte
    const updateHeaderAvatar = () => {
      const slot = document.getElementById('cagp-header-avatar-slot');
      if (!slot) return;
      try {
        const raw = localStorage.getItem('cagp_student_profile_v1');
        const profile = raw ? JSON.parse(raw) : null;
        slot.innerHTML = renderAvatarHtml(profile, 'sm');
      } catch (e) {
        slot.innerHTML = '<i class="bi bi-person-fill text-lg" aria-hidden="true" />';
      }
    };

    (window as any).__cagp_update_avatar = updateHeaderAvatar;
    updateHeaderAvatar();
  }

  setupHeaderListeners();
  document.addEventListener('astro:page-load', setupHeaderListeners);
</script>
